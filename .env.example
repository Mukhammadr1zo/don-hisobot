# Read from the process environment by config/settings.py. Values shown are the defaults.
# With DEBUG=0 a SECRET_KEY is required and cookies are HTTPS-only.
SECRET_KEY=
DEBUG=1
# Comma separated, e.g. ALLOWED_HOSTS=don.example.uz  CSRF_TRUSTED_ORIGINS=https://don.example.uz
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# 1 only behind the reverse proxy: the client IP is then taken from X-Forwarded-For.
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=5440
DB_NAME=hisobot
DB_USER=hisobot
DB_PASSWORD=hisobot
# Only for running tests in parallel: each run needs its own test database.
# TEST_DB_NAME=test_hisobot
