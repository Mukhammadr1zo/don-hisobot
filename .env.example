# --- Server: copy to .env next to compose.yaml and fill in. compose.yaml reads only these three. ---
# DOMAIN=don.example.uz   (Caddy gets the HTTPS certificate for it; ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS follow)
DOMAIN=
# SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DB_PASSWORD=

# --- Settings read by config/settings.py from the process environment. Values shown are the defaults. ---
# compose.yaml sets all of them for the server; for local work export them in the shell when needed.
# With DEBUG=0 a SECRET_KEY is required and cookies are HTTPS-only.
# DEBUG=1
# Comma separated, e.g. ALLOWED_HOSTS=don.example.uz  CSRF_TRUSTED_ORIGINS=https://don.example.uz
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=
# 1 only behind the reverse proxy: the client IP is then taken from X-Forwarded-For.
# TRUST_PROXY=0
# DB_HOST=127.0.0.1
# DB_PORT=5440          (compose.dev.yaml; a plain PostgreSQL install listens on 5432)
# DB_NAME=hisobot
# DB_USER=hisobot
# DB_PASSWORD=hisobot
# Only for running tests in parallel: each run needs its own test database.
# TEST_DB_NAME=test_hisobot
